---
import Icon from '../ui/Icon.astro';
import { contact, social } from '../../config/site';
import './Footer.css';

const year = new Date().getFullYear();
---

<footer class="footer-container">
  <div class="infos-footer-container">
    <div class="footer-infos-essentiels">
      <h3>Adresse</h3>
      <a class="maps-adresse" href={contact.mapsUrl} target="_blank" rel="noreferrer">
        <p>{contact.address.street}</p>
        <p>{contact.address.city}</p>
      </a>
    </div>
    <div class="footer-reseaux">
      <h3>Suivez-nous!</h3>
      <div class="cont-reseaux">
        <a href={social.facebook} aria-label="Facebook"><Icon name="facebook" class="icons-footer-reseaux" /></a>
        <a href={social.instagram} aria-label="Instagram"><Icon name="instagram" class="icons-footer-reseaux" /></a>
        <a href={`mailto:${contact.email}`} aria-label="Email"><Icon name="envelope" class="icons-footer-reseaux" /></a>
      </div>
    </div>
    <div class="footer-reservation">
      <h3>Contact</h3>
      <p><a href={contact.phoneHref}>{contact.phone}</a></p>
      <a href={`mailto:${contact.email}`}>{contact.email}</a>
    </div>
  </div>
  <div class="footer-politiques">
    <a href="/mentions-legales">Mentions légales</a>
    <a href="/politique-de-confidentialite">Politiques de confidentialité</a>
  </div>
  <div class="copyright">
    <p>&copy;Tous droits réserves Papy Blank {year}</p>
  </div>
</footer>
