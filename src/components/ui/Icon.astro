---
import type { SVGAttributes } from 'astro/types';
import { icons, type IconName } from './icons';

interface Props extends SVGAttributes {
  name: IconName;
}

const { name, ...rest } = Astro.props;
const icon = icons[name];
---

<svg
  viewBox={icon.viewBox}
  fill="currentColor"
  stroke="currentColor"
  stroke-width="0"
  width="1em"
  height="1em"
  aria-hidden="true"
  {...rest}
  set:html={icon.body}
/>
